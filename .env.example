# ==============================================================================
# NEXORA LABS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env (local) or configure in Cloudflare Pages / Workers Secrets.
# NEVER commit real secrets or expose server-side secrets with VITE_ prefixes.
# ==============================================================================

# --- Frontend (Public Vite Client Configuration) ---
# Base URL of the Cloudflare Pages Functions / Worker API Gateway (e.g., /api)
VITE_API_BASE_URL="/api"
# Optional: set to "true" only when deploying against a live Cloudflare API Gateway
VITE_BACKEND_CONNECTED="false"

# --- Cloudflare Pages Functions / Worker (Server-Side Only Secrets) ---
# Private Google Apps Script Web App deployment URL (kept strictly server-side)
APPS_SCRIPT_WEBAPP_URL=""
# Shared internal verification secret between Cloudflare Gateway and Apps Script
APPS_SCRIPT_INTERNAL_SECRET=""
# Comma-separated origin allowlist for authenticated CORS requests
ALLOWED_ORIGINS="https://your-production-domain.example,http://localhost:3000"
# Comma-separated Super Admin email allowlist enforced on server-side Apps Script & Gateway
SUPER_ADMIN_ALLOWLIST=""

# --- AI Studio Platform Defaults ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
